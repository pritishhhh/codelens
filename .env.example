# Copy this file to .env.local and add your OpenAI API key.
# Next.js only loads .env.local (not .env.example).
OPENAI_API_KEY=your_openai_api_key_here

# Required for live AI in production. Visitors enter this in "Live AI access".
# Keep it private; use a long random value. Sample reports need no configuration.
CODELENS_ACCESS_TOKEN=
# Optional override; defaults to gpt-4o.
OPENAI_MODEL=gpt-4o
