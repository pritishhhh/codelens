# Copy to .env.local. Keep API keys on the server; never use NEXT_PUBLIC_.
# Groq is the default provider. Create your own key at https://console.groq.com/keys
# Free-plan usage is subject to your Groq account's limits.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Required for live AI in production. Visitors enter this in "Live AI access".
# Keep it private; use a long random value. Sample reports need no configuration.
CODELENS_ACCESS_TOKEN=
# Optional paid provider: used ONLY when AI_PROVIDER=openai is explicitly set.
# There is no automatic fallback to OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
